{
  "name": "wordisle-cloudflare",
  "private": true,
  "scripts": {
    "build": "python3 cloudflare/build.py && uv run pywrangler sync && python3 cloudflare/prepare_runtime.py",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:cloudflare": "python3 -m unittest test_cloudflare",
    "check:deploy": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
